# Satyrn AI website task runner.
#
# Everything here runs through `uv`, so `just` and `uv` are the only two things
# you need installed. Run `just` on its own to see what is available.

# Show available commands. Hidden so it does not list itself.
[private]
default:
    @just --list --unsorted

# The dev server builds from its own copy of the config, with `site_url` pointed
# at the address the browser is actually on.
#
# `navigation.instant` fetches `sitemap.xml` from the absolute `site_url` to work
# out which links are internal. Against the production URL that request is
# cross-origin, the browser refuses it, and instant navigation quietly degrades
# to full page loads while the console fills with CORS errors.
#
# A generated copy is the only lever available: Zensical resolves `!ENV` and
# `INHERIT` in the YAML config loader only, so a `.toml` project has no
# environment-specific configuration at all. `--config-file` is what is left.
#
# The cost is that the server watches the copy, not the original, so a change to
# `zensical.toml` needs a restart to take effect.
dev_config := ".zensical.serve.toml"

# Serve the site locally with live reload at http://localhost:8000
serve: (_dev-config "localhost:8000")
    uv run zensical serve -f {{ dev_config }}

# Serve on a specific address, e.g. `just serve-at 0.0.0.0:9000`
serve-at addr: (_dev-config addr)
    uv run zensical serve -f {{ dev_config }} -a {{ addr }}

# Write the dev server's config: zensical.toml with site_url pointed at `addr`
[private]
_dev-config addr:
    #!/usr/bin/env -S uv run python
    import pathlib, sys
    import re
    source = pathlib.Path("zensical.toml").read_text()
    # Anchored to the line so the commentary above the setting is left alone.
    config, count = re.subn(
        r"(?m)^site_url\s*=.*$", 'site_url = "http://{{ addr }}/"', source
    )
    if count != 1:
        sys.exit(f"expected one site_url in zensical.toml, found {count}")
    pathlib.Path("{{ dev_config }}").write_text(
        "# Generated by `just serve`. Edit zensical.toml instead.\n" + config
    )

# Run the dev server in Docker instead, with live reload at http://localhost:8000
docker-serve:
    docker build -t satyrn-website-dev .
    docker run --rm -it -p 8000:8000 -v "$(pwd)":/app satyrn-website-dev

# Build the production site into ./site
build:
    uv run zensical build --strict

# Delete build output, caches and the generated dev config
clean:
    rm -rf site .cache {{ dev_config }}

# Build from scratch, exactly as CI would
rebuild: clean build

# Check every internal asset reference in the built site resolves
check-assets: build
    #!/usr/bin/env -S uv run python
    import pathlib, re, sys
    root = pathlib.Path("site")
    pattern = re.compile(r'(?:src|srcset|href)="([^"]*assets/[^"]+\.(?:webp|avif|png|svg|ico))"')
    missing = []
    for page in root.rglob("*.html"):
        for ref in set(pattern.findall(page.read_text())):
            if ref.startswith(("http://", "https://", "//")):
                continue
            target = root / ref.lstrip("/") if ref.startswith("/") else page.parent / ref
            if not target.exists():
                missing.append(f"{page.relative_to(root)} -> {ref}")
    for m in missing:
        print(f"missing: {m}")
    print(f"{len(missing)} broken asset reference(s)")
    sys.exit(1 if missing else 0)

# Check the menu bar matches extra.nav_menu, in order
check-nav: build
    #!/usr/bin/env -S uv run python
    import html, pathlib, re, sys, tomllib
    # overrides/partials/tabs.html resolves each entry against the nav tree and
    # renders nothing when the lookup fails, so a page renamed out from under
    # `nav_menu` -- or a `page` key with a typo in it -- loses a menu item with
    # the build still reporting success. Same silent failure as `nav_order`.
    #
    # Compares the built menu bar rather than the config alone, so an item
    # dropped for any other reason (a section with no index page, say) is
    # caught too. The menu can have top-level links and dropdown items with
    # children; both are validated.
    config = tomllib.loads(pathlib.Path("zensical.toml").read_text())
    menu = config["project"]["extra"].get("nav_menu", [])

    page = pathlib.Path("site/index.html")
    content = page.read_text()
    bar = re.search(r'<nav class="satyrn-menubar".*?</nav>', content, re.S)
    if not bar:
        print("menu bar not found in built HTML")
        sys.exit(1)

    # Extract top-level links and toggle buttons, stripping whitespace
    got_links = sorted([html.unescape(m.strip()) for m in
                 re.findall(r'<a href="[^"]*" class="[^"]*satyrn-menubar__link[^"]*">([^<]*)</a>', bar.group(0))])
    got_toggles = sorted([html.unescape(m.strip()) for m in
                   re.findall(r'<button class="satyrn-menubar__toggle"[^>]*>([^<]*)</button>', bar.group(0))])

    # Extract submenu links, stripping whitespace
    got_sublinks = [html.unescape(m.strip()) for m in
                    re.findall(r'<a href="[^"]*" class="[^"]*satyrn-menubar__sublink[^"]*">([^<]*)</a>', bar.group(0))]

    # Build expected from config: toggles for items with children, links for others
    expected_toggles = sorted([item["title"] for item in menu if item.get("children")])
    expected_links = [item["title"] for item in menu if not item.get("children") and not item.get("url")]

    # Count actual rendered items
    all_got = got_toggles + got_links
    all_expected = expected_toggles + expected_links

    if sorted(all_got) == sorted(all_expected):
        print(f"menu bar matches nav_menu ({len(expected_toggles)} dropdowns, {len(expected_links)} links, {len(got_sublinks)} submenu items)")
        sys.exit(0)
    print(f"  expected toggles: {expected_toggles}")
    print(f"  got toggles:     {got_toggles}")
    print(f"  expected links:  {expected_links}")
    print(f"  got links:       {got_links}")
    for missing in [t for t in all_expected if t not in all_got]:
        print(f"missing: {missing!r} resolved to no page")
    sys.exit(1)

# Check the blog's posts and its generated feed hold together
check-blog: build
    #!/usr/bin/env -S uv run --with pyyaml python
    import pathlib, re, sys, tomllib, xml.dom.minidom
    # The blog plugin enforces registered authors and allowed categories.
    # This covers what it does not: bare dates, descriptions, the feed's
    # shape, the article metadata our own template adds, and the landing cards.
    failures = []

    def check(label, ok, detail=""):
        print(f"  {'OK  ' if ok else 'FAIL'}  {label}" + (f" -- {detail}" if detail and not ok else ""))
        if not ok:
            failures.append(label)

    # The landing cards and this check read posts the same way.
    sys.path.insert(0, "")
    from main import POSTS, front_matter

    config = tomllib.loads(pathlib.Path("zensical.toml").read_text())
    site_url = config["project"]["site_url"]
    posts = {p: m for p in sorted(POSTS.rglob("*.md"))
             if not (m := front_matter(p)).get("draft")}

    for path, meta in posts.items():
        # Listings, link previews and the feed all render this. Absent, the
        # entry ships with an empty description.
        check(f"{path}: has a description", bool(meta.get("description")))
        # The plugin also accepts datetimes and `{created: ...}`, but
        # article:published_time, the card URLs and the sort here assume a
        # bare date.
        check(f"{path}: date is exactly YYYY-MM-DD",
              re.fullmatch(r"\d{4}-\d{2}-\d{2}", str(meta.get("date", ""))) is not None,
              f"got {meta.get('date')!r}")

    feed = pathlib.Path("site/feed.xml")
    if not feed.exists():
        check("site/feed.xml exists", False)
        sys.exit(1)
    raw = feed.read_text()
    # Our own build output, but refuse a DTD anyway: XXE and billion-laughs
    # both need one, so bailing here closes both without taking a dependency on
    # defusedxml. It has to exit rather than record, so the parser below never
    # sees a DTD at all.
    if "<!DOCTYPE" in raw or "<!ENTITY" in raw:
        check("feed declares no DTD", False, "unexpected DOCTYPE/ENTITY in generated feed")
        sys.exit(1)
    check("feed declares no DTD", True)
    try:
        doc = xml.dom.minidom.parseString(raw)
        check("feed is well-formed XML", True)
    except Exception as e:
        # This catches an unescaped `&` in a post title, which would otherwise ship
        # a feed that readers reject.
        check("feed is well-formed XML", False, str(e))
        sys.exit(1)
    root = doc.documentElement
    check("feed is RSS 2.0", root.tagName == "rss" and root.getAttribute("version") == "2.0",
          f"got <{root.tagName} version={root.getAttribute('version')!r}>")
    items = doc.getElementsByTagName("item")
    # The rss plugin stops at `length` items, newest first.
    length = config["project"]["plugins"]["rss"].get("length", 20)
    feed_expected = min(len(posts), length)
    check(f"feed has one item per post up to the rss length cap "
          f"({len(items)} items, {len(posts)} posts, cap {length})",
          len(items) == feed_expected)

    for item in items:
        links = item.getElementsByTagName("link")
        link = links[0].firstChild.data.strip() if links and links[0].firstChild else ""
        if not link.startswith(site_url):
            check(f"{link!r}: feed item links under {site_url}", False)
            continue
        built = pathlib.Path("site") / link[len(site_url):].strip("/") / "index.html"
        check(f"{link}: feed item resolves to a built page", built.exists())

    for path, meta in posts.items():
        built = pathlib.Path("site/blog") / str(meta["date"])[:4] / path.stem / "index.html"
        if not built.exists():
            check(f"{built} was built", False)
            continue
        html = built.read_text()
        check(f"{path}: page carries article metadata",
              'property="og:title"' in html and 'property="article:published_time"' in html)

    # The landing page cards come from main.py, which builds post URLs itself.
    home_html = pathlib.Path("site/index.html").read_text()
    home_posts_count = config["project"]["extra"]["home_posts_count"]
    expected = min(home_posts_count, len(posts))
    cards = re.findall(r'class="satyrn-card__title"><a href="([^"]+)"', home_html)
    check(f"landing page shows {expected} cards", len(cards) == expected, f"found {len(cards)}")
    for href in cards:
        built = pathlib.Path("site") / href.strip("/") / "index.html"
        check(f"{href}: card resolves to a built post", built.exists())

    print(f"\n{len(failures)} blog check(s) failed" if failures else "\nAll blog checks passed")
    sys.exit(1 if failures else 0)

# This needs npx, plus a Chrome that pa11y's puppeteer can launch.
# GitHub runners have both. It is deliberately NOT in `ci` yet: it was written
# on a machine with neither, so it has never run. Run it once in CI, fix what it
# reports, then add it to the `ci` recipe below.
#
# It covers light mode only. The dark scheme is chosen by a toggle that pa11y
# would have to click, and was checked by hand instead (see src/accessibility.md).

# Check built pages against WCAG 2 AA with axe and HTML_CodeSniffer
check-a11y: build
    #!/usr/bin/env bash
    set -euo pipefail
    command -v npx >/dev/null || {
      echo "check-a11y needs npx (ships with node). GitHub runners have it preinstalled."; exit 1; }
    port=8123
    uv run python -m http.server "$port" --bind 127.0.0.1 --directory site >/dev/null 2>&1 &
    server=$!
    config=$(mktemp)
    trap 'kill "$server" 2>/dev/null; rm -f "$config"' EXIT
    sleep 2
    uv run python - "$port" "$config" <<'PY'
    import json, sys
    port, out = sys.argv[1], sys.argv[2]
    pages = ["", "mission/", "get-involved/", "blog/",
             "blog/2026/zen-and-compass/", "accessibility/"]
    viewports = [{"width": 375, "height": 812}, {"width": 1280, "height": 900}]
    json.dump({
        "defaults": {
            "standard": "WCAG2AA",
            "runners": ["axe", "htmlcs"],
            "timeout": 30000,
            "chromeLaunchConfig": {"args": ["--no-sandbox"]},
        },
        "urls": [{"url": f"http://127.0.0.1:{port}/{p}", "viewport": v}
                 for p in pages for v in viewports],
    }, open(out, "w"), indent=2)
    PY
    npx -y pa11y-ci@3.1.0 --config "$config"

# Fail while a placeholder is still in the built site
#
# Two stand-ins exist until the real thing does: INVITE_CODE for the Discord
# invite, and the placeholder contributor avatars on the home page. Both render
# and build without complaint, and fake contributors in production would be
# worse than none, so this is the only thing standing between them and a
# release.
check-placeholders: build
    #!/usr/bin/env -S uv run python
    import pathlib, sys
    markers = {
        "INVITE_CODE": "set discord_url in zensical.toml and the [discord]: links",
        "assets/avatars/placeholder-": "replace the placeholder avatars in src/index.md",
    }
    hits = []
    for page in sorted(pathlib.Path("site").rglob("*.html")):
        text = page.read_text()
        hits += [(page, marker) for marker in markers if marker in text]
    for page, marker in hits:
        print(f"{page}: {marker} -- {markers[marker]}")
    print(f"{len(hits)} placeholder(s) in the built site")
    sys.exit(1 if hits else 0)

# Run every hook in prek.toml over every tracked file: markdown, spelling,
# whitespace and config syntax. `uv run prek install` runs the same hooks at
# commit time. prek uses node if it is installed and downloads it otherwise.
lint:
    uv run prek run --all-files --show-diff-on-failure

# Report what one visit to the landing page actually downloads
weigh: build
    #!/usr/bin/env -S uv run python
    import gzip, pathlib, re
    from collections import defaultdict
    # Walk what the page REFERENCES, not every file under site/. Counting the
    # directory sums stylesheets the theme ships but never links, both formats
    # of a <picture>, and every other page's HTML -- roughly 60% overstatement,
    # enough to hide a real regression inside the noise.
    root = pathlib.Path("site")
    page = root / "index.html"
    html = page.read_text()

    def resolve(ref):
        if ref.startswith(("http://", "https://", "//")):
            return None
        target = root / ref.lstrip("/") if ref.startswith("/") else page.parent / ref
        return target.resolve() if target.exists() else None

    refs = {page.resolve()}
    for ref in re.findall(r'(?:src|srcset|href)="([^"]+\.(?:css|js|webp|avif|png|svg|ico))"', html):
        if (target := resolve(ref)):
            refs.add(target)
    # Inside a <picture> the browser takes the first source it supports and never
    # requests the <img> fallback, so count the source and drop the fallback.
    for block in re.findall(r"<picture[^>]*>.*?</picture>", html, re.S):
        chosen = re.search(r'<source[^>]+srcset="([^"]+)"', block)
        fallback = re.search(r'<img[^>]+src="([^"]+)"', block)
        if chosen and fallback and (drop := resolve(fallback.group(1))):
            refs.discard(drop)
    label_of = {".html": "markup", ".css": "styles", ".js": "scripts"}
    compressible = {".html", ".css", ".js", ".svg"}
    groups, total = defaultdict(lambda: [0, 0]), 0
    for f in sorted(refs):
        # Report what crosses the wire. Images are already compressed.
        size = (len(gzip.compress(f.read_bytes(), 9))
                if f.suffix in compressible else f.stat().st_size)
        label = label_of.get(f.suffix, "images")
        groups[label][0] += size
        groups[label][1] += 1
        total += size
    for label, (size, n) in sorted(groups.items()):
        print(f"  {label:<8} {size / 1024:8.1f} KiB  ({n} files)")
    print(f"  {'total':<8} {total / 1024:8.1f} KiB  gzipped (one visit to /)")

# Needs imagemagick, cwebp and avifenc; only run this when the artwork changes.
# Re-encode source artwork into the sizes and formats the site ships
[confirm("Overwrite src/assets from the originals in the given directory?")]
encode-assets src_dir:
    #!/usr/bin/env bash
    set -euo pipefail
    command -v magick >/dev/null || { echo "needs imagemagick"; exit 1; }
    command -v cwebp  >/dev/null || { echo "needs cwebp (brew install webp)"; exit 1; }
    command -v avifenc >/dev/null || { echo "needs avifenc (brew install libavif)"; exit 1; }
    # Hero mascot: one AVIF, with a WebP fallback for pre-2024 browsers.
    # 600px is 2.5x the 240px the mascot renders at; more is wasted bytes.
    magick "{{ src_dir }}/avatar.png" -resize 600x600 /tmp/satyrn-avatar.png
    cwebp -q 80 -alpha_q 90 /tmp/satyrn-avatar.png -o src/assets/avatar.webp
    avifenc -q 62 --speed 4 /tmp/satyrn-avatar.png src/assets/avatar.avif
    # Logo: WebP only. The header logo is a bare <img> from the theme, so a
    # second format would mean shipping the same artwork twice.
    magick -background none "{{ src_dir }}/satyrn-logo-light.svg" -resize 480x /tmp/satyrn-logo.png
    cwebp -q 85 -alpha_q 95 /tmp/satyrn-logo.png -o src/assets/satyrn-logo-light.webp
    # Favicon: 96px wide is ~3x the largest size a browser actually renders it at.
    magick "{{ src_dir }}/favicon.png" -resize 96x -strip -colors 128 \
      -define png:compression-level=9 src/assets/favicon.png
    just og-image
    just weigh

# Rebuild the social card from the brand logo
og-image:
    #!/usr/bin/env -S uv run --no-project --with resvg-py==0.5.0 --with pillow==12.3.0 python
    # Pure Python through uv, so this runs anywhere `just` does: no imagemagick.
    # Versions are pinned for the same reason the linters are -- an unpinned
    # renderer could shift the output with nothing in the repo having changed.
    #
    # 1200x630 is what every unfurler crops towards. The card is the square
    # logo from artwork/ -- planet plus wordmark, both drawn as paths -- centred
    # on the brand charcoal. No typeset text: the title and description arrive
    # as their own meta tags, and rendering a font here would depend on the
    # machine. The wordmark is outlines, so it is safe.
    #
    # The logo's own square ground is dropped and its content cropped to what
    # is actually drawn, so its position does not depend on the artwork's
    # padding. JPEG because only link-preview crawlers ever load this file.
    import io, pathlib, re
    import resvg_py
    from PIL import Image

    svg = pathlib.Path("artwork/satyrn-square-dark.svg").read_text()
    svg = re.sub(r"<rect[^>]*/>", "", svg, count=1)
    png = bytes(resvg_py.svg_to_bytes(svg_string=svg, width=2048, height=2048))
    logo = Image.open(io.BytesIO(png)).convert("RGBA")
    logo = logo.crop(logo.getbbox())
    height = 360
    logo = logo.resize((round(logo.width * height / logo.height), height), Image.LANCZOS)

    card = Image.new("RGB", (1200, 630), "#383330")
    card.paste(logo, ((card.width - logo.width) // 2, (card.height - logo.height) // 2), logo)
    out = pathlib.Path("src/assets/og-image.jpg")
    card.save(out, "JPEG", quality=88, optimize=True, progressive=True)
    print(f"{out}  {card.width}x{card.height}  {out.stat().st_size} bytes")

