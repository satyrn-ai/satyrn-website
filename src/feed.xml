{%- macro walk(items, ns) -%}
  {%- for it in items -%}
    {%- if it.meta and it.meta.date %}{% set ns.items = ns.items + [it] %}{% endif -%}
    {%- if it.children %}{{ walk(it.children, ns) }}{% endif -%}
  {%- endfor -%}
{%- endmacro -%}
{%- set ns = namespace(items=[]) -%}
{{- walk(nav.items, ns) -}}
{%- set posts = ns.items | sort(attribute="meta.date", reverse=true) -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ config.site_name | e }}</title>
  <subtitle>{{ config.site_description | e }}</subtitle>
  <link href="{{ config.site_url }}feed.xml" rel="self"/>
  <link href="{{ config.site_url }}"/>
  <id>{{ config.site_url }}</id>
  <updated>{{ (posts[0].meta.date ~ "T00:00:00Z") if posts else "1970-01-01T00:00:00Z" }}</updated>
{%- for post in posts %}
  <entry>
    <title>{{ post.title | e }}</title>
    <link href="{{ post.canonical_url }}"/>
    <id>{{ post.canonical_url }}</id>
    <updated>{{ post.meta.date }}T00:00:00Z</updated>
    <summary>{{ post.meta.description | e }}</summary>
    {%- for slug in post.meta.authors %}
    <author><name>{{ config.extra.authors[slug].name | e }}</name></author>
    {%- endfor %}
  </entry>
{%- endfor %}
</feed>
